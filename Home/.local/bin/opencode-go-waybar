#!/usr/bin/env python3
"""Show OpenCode Go subscription limits as a Waybar custom module."""

from __future__ import annotations

import datetime as dt
import json
import math
import os
import re
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen


API_URL = "https://opencode.ai/zen/go/v1/usage"
USER_AGENT = "waybar-opencode-go-usage/1.0"
REQUEST_TIMEOUT = 8
WINDOWS = (
    ("rolling", "Rolling (5h)"),
    ("weekly", "Weekly"),
    ("monthly", "Monthly"),
)


class UsageError(Exception):
    """An expected error that can be shown safely in Waybar."""


def theme_colors() -> dict[str, str]:
    colors = {
        "low": "#98c379",
        "mid": "#e5c07b",
        "high": "#d19a66",
        "critical": "#e06c75",
    }
    theme_path = Path.home() / ".config/omarchy/current/theme/colors.toml"
    try:
        lines = theme_path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return colors

    values = {}
    for line in lines:
        if line.lstrip().startswith("#"):
            continue
        match = re.match(r'^\s*(color1|color2|color3)\s*=\s*"(#[0-9a-fA-F]{6})"', line)
        if match:
            values[match.group(1)] = match.group(2)
    if "color1" in values:
        colors["high"] = colors["critical"] = values["color1"]
    if "color2" in values:
        colors["low"] = values["color2"]
    if "color3" in values:
        colors["mid"] = values["color3"]
    return colors


def read_api_key() -> str:
    data_home = Path(
        os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local/share")
    )
    if not data_home.is_absolute():
        data_home = Path.home() / ".local/share"
    auth_path = data_home / "opencode" / "auth.json"

    try:
        credentials = json.loads(auth_path.read_text(encoding="utf-8"))
    except FileNotFoundError as exc:
        raise UsageError("OpenCode credentials were not found") from exc
    except (OSError, json.JSONDecodeError) as exc:
        raise UsageError("OpenCode credentials could not be read") from exc

    provider = credentials.get("opencode-go") if isinstance(credentials, dict) else None
    key = provider.get("key") if isinstance(provider, dict) else None
    if not isinstance(key, str) or not key.strip():
        raise UsageError("OpenCode Go API key was not found")
    return key.strip()


def fetch_usage(api_key: str) -> dict:
    request = Request(
        API_URL,
        headers={
            "Accept": "application/json",
            "Authorization": f"Bearer {api_key}",
            "User-Agent": USER_AGENT,
        },
    )

    try:
        with urlopen(request, timeout=REQUEST_TIMEOUT) as response:
            payload = json.loads(response.read())
    except HTTPError as exc:
        if exc.code == 401:
            reason = "API key rejected (HTTP 401)"
        elif exc.code == 403:
            reason = "Go usage access denied (HTTP 403)"
        elif exc.code == 429:
            reason = "usage service rate-limited the request (HTTP 429)"
        else:
            reason = f"usage service returned HTTP {exc.code}"
        raise UsageError(reason) from exc
    except (TimeoutError, URLError, OSError) as exc:
        raise UsageError("usage service could not be reached") from exc
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise UsageError("usage service returned invalid JSON") from exc

    if not isinstance(payload, dict) or not isinstance(payload.get("usage"), dict):
        raise UsageError("usage service returned an unexpected response")
    return payload["usage"]


def format_percent(value: int | float) -> str:
    return f"{value:.0f}%" if float(value).is_integer() else f"{value:.1f}%"


def reset_countdown(value: object, now: dt.datetime) -> str:
    if not isinstance(value, str) or not value:
        return "reset time unavailable"
    try:
        reset_at = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return "reset time unavailable"
    if reset_at.tzinfo is None:
        return "reset time unavailable"

    seconds = max(0, math.ceil((reset_at - now).total_seconds()))
    if seconds == 0:
        return "now"

    days, seconds = divmod(seconds, 86400)
    hours, seconds = divmod(seconds, 3600)
    minutes = math.ceil(seconds / 60)
    if days:
        return f"in {days}d {hours}h"
    if hours:
        return f"in {hours}h {minutes}m"
    return f"in {max(1, minutes)}m"


def render_usage(usage: dict, now: dt.datetime | None = None) -> dict:
    now = now or dt.datetime.now(dt.timezone.utc)
    colors = theme_colors()
    rows: list[tuple[str, int | float, str]] = []

    for key, label in WINDOWS:
        window = usage.get(key)
        if not isinstance(window, dict):
            raise UsageError(f"usage service omitted the {label.lower()} window")

        status = window.get("status")
        if status == "rate-limited":
            percent: int | float = 100
        elif status == "ok":
            percent = window.get("percent")
            if (
                isinstance(percent, bool)
                or not isinstance(percent, (int, float))
                or not 0 <= percent <= 100
                or not math.isfinite(percent)
            ):
                raise UsageError(f"usage service returned an invalid {label.lower()} percentage")
        else:
            raise UsageError(f"usage service returned an invalid {label.lower()} status")

        reset = reset_countdown(window.get("resetsAt"), now)
        note = " — limit reached" if status == "rate-limited" else ""
        color = colors["critical"] if status == "rate-limited" else color_for(percent, colors)
        detail = (
            f"{label}: <span foreground='{color}'>"
            f"{format_percent(percent)} used{note}</span> · resets {reset}"
        )
        rows.append((label, percent, detail))

    max_percent = max(row[1] for row in rows)
    if max_percent >= 90:
        severity = "critical"
    elif max_percent >= 75:
        severity = "high"
    elif max_percent >= 50:
        severity = "mid"
    else:
        severity = "low"

    return {
        "text": (
            f"<span foreground='{colors[severity]}'>"
            f"󰚩 GO {format_percent(max_percent)}</span>"
        ),
        "tooltip": "OpenCode Go usage\n" + "\n".join(row[2] for row in rows),
        "class": severity,
    }


def color_for(percent: int | float, colors: dict[str, str]) -> str:
    if percent >= 90:
        return colors["critical"]
    if percent >= 75:
        return colors["high"]
    if percent >= 50:
        return colors["mid"]
    return colors["low"]


def main() -> None:
    try:
        usage = fetch_usage(read_api_key())
        result = render_usage(usage)
    except UsageError as exc:
        colors = theme_colors()
        result = {
            "text": f"<span foreground='{colors['critical']}'>󰚩 GO --</span>",
            "tooltip": f"OpenCode Go usage unavailable\n{exc}",
            "class": "critical",
        }
    print(json.dumps(result, ensure_ascii=False))


if __name__ == "__main__":
    main()
